{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.1",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "facebook-messenger-voice-message-downloader@norbertfila.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "facebook-messenger-voice-message-downloader",
  "description": "Downloads voice messages from Facebook and Messenger.",
  "homepage_url": "https://norbertfila.com",
  "icons": {
    "64": "images/icon-transparent-64.png",
    "128": "images/icon-transparent-128.png",
    "256": "images/icon-transparent-256.png",
    "512": "images/icon-transparent-512.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*",
    "https://*.cdninstagram.com/*"
  ],
  "chromium:action": {
    "default_icon": {
      "64": "images/icon-transparent-64.png",
      "128": "images/icon-transparent-128.png",
      "256": "images/icon-transparent-256.png",
      "512": "images/icon-transparent-512.png"
    },
    "default_title": "Voice Message Downloader",
    "default_popup": "popup/index.html"
  },
  "firefox:browser_action": {
    "default_icon": {
      "64": "images/icon-transparent-64.png",
      "128": "images/icon-transparent-128.png",
      "256": "images/icon-transparent-256.png",
      "512": "images/icon-transparent-512.png"
    },
    "default_title": "Voice Message Downloader",
    "default_popup": "popup/index.html"
  },
  "background": {
    "chromium:service_worker": "background/entry.ts",
    "firefox:scripts": [
      "background/entry.ts"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "content/media/blob-interceptor.ts"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "content/entry.ts"
      ]
    }
  ]
}
