{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "react@extension.js",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "facebook-messenger-voice-message-downloader",
  "description": "Downloads voice messages from Facebook and Messenger.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "chromium:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Voice Message Downloader",
    "default_popup": "popup/index.html"
  },
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Voice Message Downloader",
    "default_popup": "popup/index.html"
  },
  "background": {
    "chromium:service_worker": "background/entry.ts",
    "firefox:scripts": [
      "background/entry.ts"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "content/entry.ts"
      ]
    }
  ]
}
